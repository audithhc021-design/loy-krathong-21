# ==========================================================
# 1. LINE LIFF (สร้างฟรีที่ https://developers.line.biz/console/)
# ==========================================================
# ใส่ LIFF ID เช่น 2001234567-AbCdEfGh (ถ้าเว้นว่าง แอพจะเปิดโหมดทดสอบ Dev Login ให้ลองเล่นได้ทันที)
NEXT_PUBLIC_LIFF_ID=

# LINE Login Channel ID สำหรับตรวจสอบ ID Token ฝั่ง Server (เช่น 2001234567)
LINE_LOGIN_CHANNEL_ID=

# ==========================================================
# 2. Supabase (สร้างฟรีที่ https://supabase.com)
# ==========================================================
# ถ้ายังไม่ใส่ ระบบจะเก็บข้อมูลในไฟล์ .data/local-db.json ชั่วคราวสำหรับทดสอบบนเครื่อง
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================================
# 3. รหัสผ่านเข้าเมนูแอดมิน & จับฉลากของผู้อำนวยการ
